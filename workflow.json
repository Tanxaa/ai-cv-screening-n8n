{
  "name": "AI CV Screening",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI CV Screening",
        "formDescription": "Upload a CV (PDF) and paste a job description. Use fake CVs only.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Candidate name",
              "placeholder": "Used only to remove the name from the CV"
            },
            {
              "fieldLabel": "Job title",
              "requiredField": true
            },
            {
              "fieldLabel": "Job description",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "CV",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "n1",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "7c1d2f8e-3a4b-4c5d-9e6f-0a1b2c3d4e5f"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "CV",
        "options": {}
      },
      "id": "n2",
      "name": "Extract CV text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $('On form submission').first().json;\nconst name = (form['Candidate name'] || '').trim();\n\nreturn $input.all().map(item => {\n  let text = item.json.text || '';\n\n  // remove contact details and links\n  text = text\n    .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[EMAIL]')\n    .replace(/\\+?\\d[\\d\\s().-]{8,}\\d/g, '[PHONE]')\n    .replace(/https?:\\/\\/\\S+|www\\.\\S+/gi, '[LINK]');\n\n  // remove the candidate's name if provided\n  if (name) {\n    name.split(/\\s+/).filter(p => p.length > 1).forEach(part => {\n      const safe = part.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n      text = text.replace(new RegExp(safe, 'gi'), '[CANDIDATE]');\n    });\n  }\n\n  return {\n    json: {\n      candidateId: 'C-' + Date.now().toString(36),\n      jobTitle: form['Job title'] || '',\n      jobDescription: form['Job description'] || '',\n      cvAnonymised: text,\n    },\n  };\n});"
      },
      "id": "n3",
      "name": "Anonymise CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=[PROMPT REDACTED]\n\nJOB TITLE: {{ $json.jobTitle }}\n\nJOB DESCRIPTION:\n{{ $json.jobDescription }}\n\nCV (anonymised):\n{{ $json.cvAnonymised }}",
        "hasOutputParser": true
      },
      "id": "n4",
      "name": "Score CV with LLM",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        720,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.1
        }
      },
      "id": "n5",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        640,
        220
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"number\"\n    },\n    \"recommendation\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"shortlist\",\n        \"maybe\",\n        \"reject\"\n      ]\n    },\n    \"matched_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"missing_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"strengths\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"concerns\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"reasoning\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"recommendation\",\n    \"matched_skills\",\n    \"missing_skills\",\n    \"reasoning\"\n  ]\n}"
      },
      "id": "n6",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        860,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "candidateId",
              "value": "={{ $('Anonymise CV').item.json.candidateId }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "jobTitle",
              "value": "={{ $('Anonymise CV').item.json.jobTitle }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "score",
              "value": "={{ $json.output?.score ?? 0 }}",
              "type": "number"
            },
            {
              "id": "a4",
              "name": "recommendation",
              "value": "={{ $json.output?.recommendation ?? 'error' }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "matched_skills",
              "value": "={{ ($json.output?.matched_skills ?? []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "missing_skills",
              "value": "={{ ($json.output?.missing_skills ?? []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "a7",
              "name": "reasoning",
              "value": "={{ $json.output?.reasoning ?? 'Scoring failed: check the LLM node' }}",
              "type": "string"
            },
            {
              "id": "a8",
              "name": "processedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Flatten result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1080,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.score }}",
              "rightValue": 75,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n8",
      "name": "Score >= 75?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "screening@example.com",
        "toEmail": "you@example.com",
        "subject": "=Shortlist: {{ $json.candidateId }} scored {{ $json.score }} for {{ $json.jobTitle }}",
        "emailFormat": "text",
        "text": "=Candidate {{ $json.candidateId }} scored {{ $json.score }}/100 for {{ $json.jobTitle }}.\n\nRecommendation: {{ $json.recommendation }}\nMatched: {{ $json.matched_skills }}\nMissing: {{ $json.missing_skills }}\n\nReasoning: {{ $json.reasoning }}\n\nThis is a decision-support score. A human should review the CV.",
        "options": {}
      },
      "id": "n9",
      "name": "Email shortlist alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1800,
        -160
      ],
      "onError": "continueRegularOutput"
    },
